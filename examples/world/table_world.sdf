<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="table_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light type="point" name="ambient_light">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Industrial Metal Table -->
    <model name="industrial_table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Table Top -->
      <link name="table_top">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="table_top_collision">
          <geometry>
            <box>
              <size>1.5 1.0 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_top_visual">
          <geometry>
            <box>
              <size>1.5 1.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
            <pbr>
              <metal>
                <metalness>0.8</metalness>
                <roughness>0.3</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>4.27</ixx>
            <iyy>9.48</iyy>
            <izz>13.54</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <!-- Table Leg 1 (Front Left) -->
      <link name="leg_1">
        <pose>-0.65 -0.4 0.3625 0 0 0</pose>
        <collision name="leg_1_collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.725</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_1_visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.725</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.25 1</ambient>
            <diffuse>0.3 0.3 0.35 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <pbr>
              <metal>
                <metalness>0.9</metalness>
                <roughness>0.2</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>

      <!-- Table Leg 2 (Front Right) -->
      <link name="leg_2">
        <pose>0.65 -0.4 0.3625 0 0 0</pose>
        <collision name="leg_2_collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.725</size>
            </box>
          </geometry>
        </collision>
