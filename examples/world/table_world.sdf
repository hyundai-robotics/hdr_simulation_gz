                <roughness>0.2</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>

      <!-- Fixed joints to connect legs to table top -->
      <joint name="leg_1_joint" type="fixed">
        <parent>table_top</parent>
        <child>leg_1</child>
      </joint>
      <joint name="leg_2_joint" type="fixed">
        <parent>table_top</parent>
        <child>leg_2</child>
      </joint>
      <joint name="leg_3_joint" type="fixed">
        <parent>table_top</parent>
        <child>leg_3</child>
      </joint>
      <joint name="leg_4_joint" type="fixed">
        <parent>table_top</parent>
        <child>leg_4</child>
      </joint>
    </model>

