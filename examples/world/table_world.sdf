    <!-- Graspable Cubes on Table 2 (near edge for robot reach) -->
    <!-- Cube 1 - Red -->
    <model name="cube_red">
      <pose>-0.2 0.95 0.8 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000417</ixx>
            <iyy>0.0000417</iyy>
            <izz>0.0000417</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
