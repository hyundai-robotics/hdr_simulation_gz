      <!-- Table Leg 4 (Back Right) -->
      <link name="leg_4">
        <pose>0.65 0.4 0.3625 0 0 0</pose>
        <collision name="leg_4_collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.725</size>
